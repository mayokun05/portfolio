---
import { Image } from 'astro:assets';
import portrait from '../assets/profile/mayokun.jpg';
import { profile } from '../data/profile';
---

<section class="hero">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow">{profile.role}</p>
      <h1>{profile.headline}</h1>
      <p class="lede">{profile.about[0]}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#work">See the work</a>
        <a class="btn btn-ghost" href="#contact">Start a conversation</a>
      </div>
      <p class="meta"><span class="dot" aria-hidden="true"></span>{profile.availability} · {profile.location}</p>
    </div>
    <div class="portrait">
      <Image src={portrait} alt={`Portrait of ${profile.name}`} widths={[320, 480, 640]} sizes="(max-width: 900px) 60vw, 400px" loading="eager" />
    </div>
  </div>
</section>

<style>
  .hero { padding: 56px 0 72px; }
  .grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .hero { padding: 96px 0 112px; } .grid { grid-template-columns: 1.5fr 1fr; gap: 64px; } }
  h1 { max-width: 20ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 28px 0 24px; }
  .meta { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 0.92rem; margin: 0; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #2f9e5b; box-shadow: 0 0 0 4px color-mix(in srgb, #2f9e5b 20%, transparent); flex: none; }
  .portrait { justify-self: center; width: min(100%, 400px); }
  /* Entrance on first load: the copy rises in a short stagger, the portrait settles in. */
  @media (prefers-reduced-motion: no-preference) {
    .copy > * { animation: rise var(--dur-slow) var(--ease-out) both; }
    .copy > :nth-child(2) { animation-delay: 80ms; }
    .copy > :nth-child(3) { animation-delay: 160ms; }
    .copy > :nth-child(4) { animation-delay: 240ms; }
    .copy > :nth-child(5) { animation-delay: 320ms; }
    .portrait { animation: settle 900ms var(--ease-out) 120ms both; }
    .dot { animation: pulse 2.4s ease-in-out infinite; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes settle { from { opacity: 0; transform: scale(0.96); } to { opacity: 1; transform: none; } }
  @keyframes pulse { 50% { box-shadow: 0 0 0 7px color-mix(in srgb, #2f9e5b 0%, transparent); } }
  .portrait :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 24px; box-shadow: var(--shadow); }
  @media (max-width: 899px) { .portrait { order: -1; width: min(60%, 260px); justify-self: start; } }
</style>
