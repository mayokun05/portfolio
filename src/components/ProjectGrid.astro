---
import ProjectCard from './ProjectCard.astro';
import { allTools, projects } from '../data/projects';

const counts = new Map(allTools.map((tool) => [tool, projects.filter((project) => project.tools.includes(tool)).length]));
---

<section id="work" class="section">
  <div class="wrap">
    <h2>Case studies</h2>
    <div class="filters" role="group" aria-label="Filter projects by tool">
      <button type="button" class="filter" aria-pressed="true" data-filter="all">All <span>{projects.length}</span></button>
      {
        allTools.map((tool) => (
          <button type="button" class="filter" aria-pressed="false" data-filter={tool}>
            {tool} <span>{counts.get(tool)}</span>
          </button>
        ))
      }
    </div>
    <ul class="grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </ul>
    <p class="status visually-hidden" aria-live="polite"></p>
  </div>
</section>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 28px; }
  .filter { font: 500 0.9rem/1 var(--font-body); padding: 9px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--text); cursor: pointer; transition: color var(--dur-fast) ease, border-color var(--dur-fast) ease, background var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out); }
  .filter:hover { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }
  .filter:active { transform: scale(0.96); }
  .filter span { color: var(--muted); margin-left: 4px; font-size: 0.8rem; }
  .filter[aria-pressed='true'] { background: var(--accent); color: var(--bg); border-color: var(--accent); }
  .grid > :global(li.entering) { animation: card-in var(--dur-slow) var(--ease-out) both; }
  @keyframes card-in { from { opacity: 0; transform: translateY(12px) scale(0.98); } to { opacity: 1; transform: none; } }
  .filter[aria-pressed='true'] span { color: inherit; opacity: 0.7; }
  .grid { display: grid; gap: 20px; padding: 0; margin: 0; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) {
    .grid { grid-template-columns: repeat(6, 1fr); }
    .grid > :global(.card) { grid-column: span 2; }
    .grid > :global(.card.featured) { grid-column: span 3; }
  }
</style>

<script>
  // Show only the cards whose tools include the chosen filter. Cards carry their tools in data-tools.
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));
  const cards = Array.from(document.querySelectorAll<HTMLLIElement>('[data-tools]'));
  const status = document.querySelector<HTMLParagraphElement>('#work .status');

  const applyFilter = (filter: string): void => {
    let shown = 0;
    for (const card of cards) {
      const tools = (card.dataset['tools'] ?? '').split('|');
      const match = filter === 'all' || tools.includes(filter);
      card.hidden = !match;
      // Replay a short entrance on each card the filter keeps, so the change reads as a change.
      card.classList.remove('entering');
      if (match) {
        void card.offsetWidth;
        card.style.animationDelay = `${shown * 40}ms`;
        card.classList.add('entering', 'is-visible');
      }
      if (match) shown += 1;
    }
    for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset['filter'] === filter));
    if (status) status.textContent = `${shown} projects shown`;
  };

  for (const button of buttons) {
    button.addEventListener('click', (): void => applyFilter(button.dataset['filter'] ?? 'all'));
  }
</script>
