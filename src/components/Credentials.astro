---
import { Image } from 'astro:assets';
import { certificates } from '../data/certificates';
import { education, memberships } from '../data/experience';
---

<section id="credentials" class="section">
  <div class="wrap">
    <h2>Education, membership and certificates</h2>
    <div class="facts">
      <div>
        <h3>{education.degree}</h3>
        <p>{education.school}, {education.location}</p>
      </div>
      {
        memberships.map((item) => (
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}, {item.date}</p>
          </div>
        ))
      }
    </div>
    <ul class="certs">
      {
        certificates.map((cert, index) => (
          <li>
            <button type="button" class="cert" data-dialog={`cert-${index}`}>
              <Image src={cert.image} alt={`${cert.title} certificate from ${cert.issuer}`} widths={[300, 480]} sizes="(max-width: 700px) 50vw, 260px" />
              <span class="title">{cert.title}</span>
              <span class="issuer">{cert.issuer}</span>
            </button>
            <dialog id={`cert-${index}`} aria-label={cert.title}>
              <form method="dialog"><button class="close" aria-label="Close">×</button></form>
              <Image src={cert.image} alt={`${cert.title} certificate from ${cert.issuer}`} widths={[800, 1400]} sizes="90vw" />
            </dialog>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .facts { display: grid; gap: 20px; margin: 32px 0 40px; }
  @media (min-width: 760px) { .facts { grid-template-columns: 1fr 1fr; } }
  .facts > div { padding: 20px 24px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .facts h3 { margin-bottom: 4px; }
  .facts p { margin: 0; color: var(--muted); }
  .certs { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 1000px) { .certs { grid-template-columns: repeat(4, 1fr); } }
  .cert { width: 100%; text-align: left; padding: 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: inherit; cursor: zoom-in; overflow: hidden; display: flex; flex-direction: column; font: inherit; transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-base) ease, box-shadow var(--dur-base) ease; }
  .cert:hover, .cert:focus-visible { transform: translateY(-4px); border-color: var(--accent); box-shadow: var(--shadow); }
  .cert:hover .title, .cert:focus-visible .title { color: var(--accent); }
  .cert :global(img) { transition: transform var(--dur-slow) var(--ease-out); }
  .cert:hover :global(img) { transform: scale(1.04); }
  .title { transition: color var(--dur-fast) ease; }
  .cert :global(img) { aspect-ratio: 4 / 3; object-fit: cover; width: 100%; border-bottom: 1px solid var(--line); }
  .title { padding: 12px 14px 0; font-weight: 600; font-size: 0.92rem; line-height: 1.35; }
  .issuer { padding: 2px 14px 14px; font-size: 0.82rem; color: var(--muted); }
  dialog { border: 0; padding: 0; border-radius: 12px; max-width: min(92vw, 1100px); background: var(--surface); }
  dialog::backdrop { background: rgb(0 0 0 / 70%); }
  dialog[open] { animation: zoom-in var(--dur-base) var(--ease-out); }
  dialog[open]::backdrop { animation: fade-in var(--dur-base) ease; }
  @keyframes zoom-in { from { opacity: 0; transform: scale(0.96); } to { opacity: 1; transform: none; } }
  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
  dialog :global(img) { max-height: 85vh; width: auto; }
  .close { position: absolute; right: 8px; top: 8px; width: 36px; height: 36px; border-radius: 50%; border: 0; background: rgb(0 0 0 / 60%); color: #fff; font-size: 1.4rem; cursor: pointer; }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-dialog]')) {
    const dialog = document.getElementById(button.dataset['dialog'] ?? '');
    if (!(dialog instanceof HTMLDialogElement)) continue;
    button.addEventListener('click', (): void => dialog.showModal());
    // Clicking the dark backdrop closes the dialog.
    dialog.addEventListener('click', (event: MouseEvent): void => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
