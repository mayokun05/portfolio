---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** The region to show. Without it the image covers the frame from its center. */
  focus?: { x: number; y: number; zoom: number } | undefined;
  /** Frame width divided by frame height. */
  ratio?: number;
  widths: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
  transitionName?: string;
}

const { image, alt, focus, ratio = 1.6, widths, sizes, loading = 'lazy', transitionName } = Astro.props;

// Clamp the crop so the frame never shows past the image edge.
// The frame shows 1/zoom of the image width and this share of its height:
const clamp = (value: number, max: number): number => Math.min(Math.max(value, 0), Math.max(max, 0));
const visibleHeight = focus ? image.width / (ratio * focus.zoom * image.height) : 1;
const crop = focus
  ? { x: clamp(focus.x, 100 - 100 / focus.zoom), y: clamp(focus.y, 100 - 100 * visibleHeight), zoom: focus.zoom }
  : undefined;
const frameStyle = `aspect-ratio: ${ratio};${transitionName ? ` view-transition-name: ${transitionName};` : ''}`;
const imageStyle = crop ? `width: ${crop.zoom * 100}%; transform: translate(-${crop.x}%, -${crop.y}%);` : undefined;
---

<div class:list={['shot', { cropped: crop }]} style={frameStyle}>
  <div class="inner">
    <Image src={image} alt={alt} widths={widths} sizes={sizes} loading={loading} style={imageStyle} />
  </div>
</div>

<style>
  .shot { position: relative; overflow: hidden; background: var(--surface-2); }
  .inner { position: absolute; inset: 0; transition: transform var(--dur-slow) var(--ease-out); }
  .inner :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .cropped .inner :global(img) { position: absolute; top: 0; left: 0; height: auto; max-width: none; }
</style>
