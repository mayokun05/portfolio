---
import type { Project } from '../data/projects';
import Shot from './Shot.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<li class:list={['card', { featured: project.featured }]} data-tools={project.tools.join('|')}>
  <a href={`${base}/projects/${project.slug}/`}>
    <Shot
      image={project.image}
      alt={`Dashboard for ${project.title}`}
      focus={project.focus}
      widths={[480, 800, 1200]}
      sizes="(max-width: 700px) 180vw, (max-width: 1100px) 90vw, 640px"
      transitionName={`shot-${project.slug}`}
    />
    <div class="body">
      <ul class="tools">
        {project.featured && <li class="chip badge">Client work</li>}
        {project.tools.map((tool) => <li class="chip">{tool}</li>)}
      </ul>
      <h3>{project.title}</h3>
      {
        project.result ? (
          <p class="result">
            <strong>{project.result.value}</strong>
            <span>{project.result.label}</span>
          </p>
        ) : (
          <p class="summary">{project.summary}</p>
        )
      }
    </div>
  </a>
</li>

<style>
  .card { list-style: none; }
  .card[hidden] { display: none; }
  a { display: flex; flex-direction: column; height: 100%; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; color: inherit; text-decoration: none; transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) ease, border-color var(--dur-base) ease; }
  a:hover, a:focus-visible { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--accent); }
  a:active { transform: translateY(-1px) scale(0.99); }
  a > :global(.shot) { border-bottom: 1px solid var(--line); }
  a:hover :global(.inner), a:focus-visible :global(.inner) { transform: scale(1.04); }
  .body { padding: 20px 20px 22px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .tools { display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0; }
  .badge { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  h3 { font-size: 1.1rem; margin: 0; transition: color var(--dur-fast) ease; }
  .featured h3 { font-size: 1.3rem; }
  a:hover h3, a:focus-visible h3 { color: var(--accent); }
  .result { margin: auto 0 0; padding-top: 14px; border-top: 1px solid var(--line); display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: 12px; }
  .result strong { font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; line-height: 1; color: var(--accent); font-variant-numeric: tabular-nums; }
  .result span { font-size: 0.88rem; line-height: 1.4; color: var(--muted); }
  .summary { margin: auto 0 0; font-size: 0.92rem; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
