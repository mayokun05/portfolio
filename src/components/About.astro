---
import { profile } from '../data/profile';
const [, ...rest] = profile.about;
---

<section id="about" class="section">
  <div class="wrap grid">
    <div>
      <h2>Accuracy with legal and operational consequences</h2>
    </div>
    <div class="text">{rest.map((paragraph) => <p>{paragraph}</p>)}</div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 16px 64px; }
  @media (min-width: 900px) { .grid { grid-template-columns: 1fr 1.4fr; } }
  .text { max-width: var(--read); font-size: 1.08rem; }
  .text p:last-child { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.45; margin-top: 1.4em; }
</style>
